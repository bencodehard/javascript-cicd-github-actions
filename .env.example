# Server
PORT=3000
NODE_ENV=development

# Postgres - {set up for development without SSL}
# DATABASE_URL="postgresql://app:SuperStrongPassword123!@host.docker.internal:5432/appdb?schema=public&sslmode=no-verify"

# Postgres - {set up for Prod with SSL}
DATABASE_URL=postgresql://app:SuperStrongPassword123!@host.docker.internal:5432/appdb?schema=public&sslmode=require
NODE_EXTRA_CA_CERTS=./example_certs/ca.crt

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# ถ้าใช้ ACL user
REDIS_USERNAME=app
REDIS_PASSWORD=app_redis_password
REDIS_DB=0

# Auth
JWT_SECRET=supersecretjwtkeychangeme
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# SonarQube
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=sqp_b25e7e0adb4be173705c65b905849bd8c611356f